  "installer_signatures": {
    "_comment": "Self-extracting installer / wrapper name -> ASCII byte signatures that identify it. The signatures are searched in the sampled bytes in file order and the FIRST hit wins, so keep the more specific wrapper above a generic one. A hit means the real payload is nested inside the installer and needs unpacking before its IOCs are meaningful.",
    "entries": {
      "NSIS": [
        "Nullsoft.NSIS.exehead",
        "Nullsoft Install System",
        "NSIS Error"
      ],
      "Inno Setup": [
        "Inno Setup",
        "InnoSetupLdr"
      ],
      "InstallShield": [
        "InstallShield"
      ],
      "Wise Installer": [
        "Wise Installation"
      ],
      "Setup Factory": [
        "Setup Factory"
      ],
      "7-Zip SFX": [
        ";!@Install@!UTF-8!",
        "7zSFX"
      ],
      "WinRAR SFX": [
        "WinRAR SFX"
      ],
      "Electron (asar)": [
        "app.asar"
      ],
      "Squirrel/Electron": [
        "Squirrel"
      ]
    }
  },
  "android_protectors": {
    "_comment": "Android app-protector / DEX packer -> regexes matched against the file NAMES inside the APK. Name matching is used because it is fast and reliable; each of these wraps or encrypts the real classes.dex, which is exactly why a protected APK's string sweep comes back thin. Regexes are applied case-insensitively with re.search.",
    "entries": {
      "Bangcle / SecNeo": [
        "libsecexe\\.so$",
        "libsecmain\\.so$",
        "libSecShell.*\\.so$",
        "libDexHelper.*\\.so$",
        "bangcle_classes\\.jar$",
        "secData0\\.jar$"
      ],
      "Qihoo 360 Jiagu": [
        "libjiagu.*\\.so$",
        "libprotectClass\\.so$",
        "libqihoo.*\\.so$"
      ],
      "Tencent Legu": [
        "libshell.*\\.so$",
        "libtup\\.so$",
        "libtosprotection.*",
        "libtxsafemode\\.so$"
      ],
      "Ijiami": [
        "ijiami\\.dat$",
        "ijiami\\.ajm$",
        "libexec\\.so$",
        "libexecmain\\.so$",
        "libixgja\\.so$"
      ],
      "Baidu Protect": [
        "libbaiduprotect.*\\.so$",
        "baiduprotect.*\\.jar$"
      ],
      "NetEase Yidun": [
        "libnesec\\.so$"
      ],
      "DexProtector": [
        "dexprotect.*",
        "classes\\.dex\\.dat$",
        "assets/dp\\..*\\.so.*"
      ],
      "Alibaba / Mobile Security SDK": [
        "libmobisec\\.so$",
        "libpreverify1\\.so$",
        "libsgmain\\.so$",
        "libsgsecuritybody\\.so$"
      ],
      "AppSuit / CoVault": [
        "libAppSuit\\.so$",
        "libcovault.*\\.so$"
      ],
      "Promon SHIELD": [
        "libshield\\.so$"
      ],
      "Virbox Protector": [
        "libvbox.*\\.so$"
      ],
      "Nagain / APKProtect": [
        "libnagain.*\\.so$",
        "libapkprotect.*\\.so$"
      ]
    }
  }
