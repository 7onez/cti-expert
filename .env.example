# ============================================================================
#  cti-expert — API keys  (.env.example)
# ============================================================================
#  cti-expert runs KEYLESS / FREE by default. EVERY key below is OPTIONAL and
#  only *upgrades* an existing capability — leave any blank and that feature
#  falls back to its free/keyless path.
#
#  HOW TO USE
#    1) Copy this file to ".env" in this same folder (the skill root):
#         cp .env.example .env
#    2) Paste in the keys you have; leave the rest blank.
#    -- or, instead of editing the file --
#         uv run scripts/apikeys/apikeys.py set shodan <YOUR_KEY>
#
#  Resolution order:  environment variable  >  this .env  >  keyless
#  Security:  never commit your real ".env" (it is gitignored); chmod 600.
#  Check:     uv run scripts/apikeys/apikeys.py status | test | unlocks
#  Regenerate:  uv run scripts/apikeys/apikeys.py example > .env.example
# ============================================================================

# --- Infrastructure / host search --------------------------------
# Shodan — /webpivot: reverse favicon mmh3 hash -> hosts; /cert-pivot: reverse TLS cert fingerprint -> hosts; host/service intelligence  (freemium)
#   get a key: https://account.shodan.io
SHODAN_API_KEY=
# Censys — /webpivot: reverse favicon MD5 -> hosts; /cert-pivot: cert fingerprint_sha256 -> hosts; certificate + host search  (freemium)
#   get a key: https://accounts.censys.io/settings/personal-access-tokens
CENSYS_API_KEY=
CENSYS_ORG_ID=
# FOFA — /webpivot: reverse favicon icon_hash + tracker body -> hosts; IP reverse  (freemium)
#   get a key: https://fofa.info
FOFA_KEY=
FOFA_EMAIL=
# urlscan.io PRO — /webpivot + /scam-check: authenticated DOM content search, related domains/IPs, submit scans  (freemium)
#   get a key: https://urlscan.io/user/apikey/
URLSCAN_API_KEY=
# Quake (360) — /webpivot + /icp: independent CN cyberspace index — favicon mmh3, body/ICP-string search -> hosts Shodan and FOFA miss  (freemium)
#   get a key: https://quake.360.net/quake/#/help?id=5eba54d8fda2a52f7bde6bb0&title=API
QUAKE_API_KEY=
# ZoomEye — /webpivot + /cert-pivot: reverse favicon iconhash (mmh3) -> hosts; CN-weighted asset search (also drives the kunyu console)  (freemium)
#   get a key: https://www.zoomeye.ai/profile
ZOOMEYE_API_KEY=
# Hunter.how — /webpivot + /cert-pivot: independent CN cyberspace index — reverse favicon_hash (mmh3) / cert / web.body / domain / ip -> hosts (a FOFA/Quake/ZoomEye peer; strongest when FOFA quota is spent or for CN-hosted infra)  (freemium)
#   get a key: https://hunter.how/search-api
HUNTERHOW_API_KEY=
# IPinfo — /webpivot + IP enrichment: ASN/org, reverse hostname, geo, and privacy flags (hosting/proxy/vpn/tor/relay) for an IP  (freemium)
#   get a key: https://ipinfo.io/account/token
IPINFO_TOKEN=
# FlareSolverr — /webpivot: routes fetches through a local FlareSolverr proxy to solve Cloudflare/JS interstitials when a target sits behind a challenge page. This is a service URL, not an API key  (free)
#   get a key: https://github.com/FlareSolverr/FlareSolverr
FLARESOLVERR_URL=
# Browser engines — DOM renders (--render / --render-extract / render_confirm) run on Moli (the
# default install; DOM-first, ~1/7 of Chromium's memory); screenshots, engage and the Cloudflare
# escalation always use Chromium (install --headless). auto = Moli when installed and the proxy
# scheme is verified for it, else Chromium. Values: auto | moli | chromium. Blank -> auto.
CTI_BROWSER=
# Path to the moli binary when it is not on PATH or in ~/.local/bin (%LOCALAPPDATA%\Moli\bin).
MOLI_BIN=

# --- DNS / certs / WHOIS -----------------------------------------
# SecurityTrails — /webpivot + /dns-history: passive DNS, subdomains, WHOIS + DNS history  (freemium)
#   get a key: https://securitytrails.com/app/account/credentials
SECURITYTRAILS_API_KEY=
SECURITYTRAILS_API_KEY_FALLBACK=
# Validin — /webpivot + /cti + harness: passive DNS, subdomains, reverse-IP, favicon/cert/body-hash reverse, lookalikes, reputation (FREE Community key)
#   get a key: https://app.validin.com/  (Community edition, free)
VALIDIN_API_KEY=
VALIDIN_API_KEY_FALLBACK=
# WhoisXML — /webpivot --whois + /whois: current + historic WHOIS, reverse-WHOIS by email/name  (freemium)
#   get a key: https://whoisxmlapi.com
WHOISXML_API_KEY=
# SSLMate CertSpotter — /cert-history + /webpivot: higher-rate CT lookups (optional; crt.sh is free/keyless)  (free-tier)
#   get a key: https://sslmate.com/certspotter/
CERTSPOTTER_API_KEY=
# CertIndex — /cert-history + /webpivot: ~1-year CT backup (currently valid certificates), asked only
#   when crt.sh is degraded or empty. FREE TIER IS PERSONAL / NON-COMMERCIAL ONLY. 10 full-domain
#   lookups/hour ACCOUNT-WIDE (each page = one lookup), 10 000/month; quota read free via /v1/usage.
#   get a key: https://ctindex.io
CERTINDEX_API_KEY=
# CertKit (app.certkit.io) web login — Discovery CT search export (no API for it): ~1 year, expired
#   certificates included, asked only when crt.sh is degraded or empty. Breaks if MFA is enabled on
#   the account or the login form changes (reported as a failed source, never as "no certificates").
CERTKIT_EMAIL=
CERTKIT_PASSWORD=
# ZoneCruncher / zetalytics — /breach-deep + /email-deep: reverse registrant/SOA email and passive A. Sent when this key is set. `apikeys test` spends one query  (freemium)
#   get a key: https://zetalytics.com/feb20/hands-on.html
ZONECRUNCHER_API_KEY=
# Passive DNS / Passive SSL (CIRCL COF) — /webpivot: historical A/AAAA (the IPs a host used before its current CDN front) + co-hosted domains, and the cert->IP passive-SSL direction that recovers an origin from behind a CDN (one CIRCL account covers both). Needs PDNS_USERNAME + PDNS_PASSWORD (+ optional PDNS_URL for a COF-compatible instance)  (freemium)
#   get a key: https://www.circl.lu/services/passive-dns/
PDNS_PASSWORD=
PDNS_USERNAME=
PDNS_URL=

# --- Analytics-ID pivot ------------------------------------------
# DNSLytics — /webpivot: reverse AdSense (ca-pub-) / legacy GA (UA-) ID -> sibling domains  (freemium)
#   get a key: https://dnslytics.com/api
DNSLYTICS_API_KEY=

# --- Breach / leak / darknet -------------------------------------
# Hudson Rock — /breach-deep + /email-deep: Cavalier v3 infostealer search. Sent when this key is set. Passwords stripped from the result  (freemium)
#   get a key: https://www.hudsonrock.com
HUDSONROCK_API_KEY=
# OSINT Industries — /osint-industries + /email-deep: account existence for an email/phone/username/name/wallet (registered platforms, self-declared names, masked hints, HIBP + WHOIS rows). 1 credit per lookup, +3 with premium modules; `apikeys test` reads the free credit balance. Leads only, never attribution  (paid)
#   get a key: https://docs.osint.industries/docs/api-keys
OSINT_INDUSTRIES_API_KEY=
# abuse.ch — /threat-check + /scam-check: URLhaus + ThreatFox + MalwareBazaar. Auth-Key header required since 2024; without it those feeds are NOT CONSULTED  (free-tier)
#   get a key: https://auth.abuse.ch/
ABUSE_CH_API_KEY=
# Spamhaus Intelligence API (SIA) — /threat-check + /scam-check FALLBACK: IP XBL/CSS/BCL listing history + domain reputation/DBL listing, queried only when the primary feeds did not corroborate MALICIOUS. Login -> 24 h token cached in .spamhaus-token.json. Quote the password if it holds shell characters: SPAMHAUS_PASSWORD='...'  (free Developer License: 6 months, 5,000 queries/month)
#   get a key: https://www.spamhaus.com/data-access/intelligence-api-developer-license/
SPAMHAUS_USERNAME=
SPAMHAUS_PASSWORD=
# ChongLuaDao — /cld + /scam-check + /threat-check + /phone + /breach-deep + /email-deep + /email-hygiene + /vuln-check + /impersonate + /webpivot --whois: first-party VN threat intel — URL/IP/hash/email/phone/bank IoC verdicts (client talks only to CLD; CLD fetches target server-side), 20M-URL denylist search, data-leak/breach exposure + full-export, deep AI URL analysis, brand-protection lookalikes, CVE/KEV + threat-actor feeds, STIX/MISP feeds. See connectors/chongluadao-api.md  (premium)
#   get a key: https://chongluadao.vn
CHONGLUADAO_API_KEY=
# Intelligence X (IntelX) — /breach-deep + darknet search: dark-web, paste, and leak selectors  (freemium)
#   get a key: https://intelx.io/account?tab=developer
INTELX_API_KEY=
# GrayHatWarfare — /grayhatwarfare, /secrets, /docleak: open buckets (S3/Azure/GCS/DO Spaces) + exposed files, the shortener corpus (long URLs behind goo.gl/bit.ly links, a handle's short links) and the git corpus (committers, token-in-code, TruffleHog-flagged files). Auto-fires per apex in `pipeline open` (loop: --full only). Graded EXPOSURE / leads, never a same-operator pivot  (freemium; plan tier measured via the free /api/account)
#   get a key: https://grayhatwarfare.com/account
GRAYHATWARFARE_API_KEY=
# ANY.RUN — setting this key also enables automatic sandbox submission of discovered APKs/installers
# in spending case runs. The file is first downloaded to cases/<case>/bin/ and statically analysed.
# --free-only / scope.json no_spend / loop without --full keep static analysis but DO NOT upload.
# Uploads use the private-by-default plan gate; a public task needs ANYRUN_ALLOW_PUBLIC=1.
# TI Lookup is a SEPARATE licence from sandbox submission; check with bp_anyrun.py keycheck --probe.
#   get a key: https://app.any.run/profile
ANYRUN_API_KEY=
# Standing authorization for PUBLIC tasks if your sandbox plan cannot create private tasks.
# WARNING: an automatic case run with a key and this set to 1 can publish each downloaded
# suspicious binary world-wide. Leave blank to refuse uploads on a public-only plan.
# Direct anyrun_submit calls still require confirmation for each submission.
ANYRUN_ALLOW_PUBLIC=

# --- Crypto / blockchain -----------------------------------------
# Blockchair — /crypto-balance + /webpivot --wallets: full balance + lifetime received/sent across BTC/ETH/LTC/BCH/DOGE/DASH/ZEC  (freemium)
#   get a key: https://blockchair.com/api/docs
BLOCKCHAIR_API_KEY=
# Subscan — /crypto-balance: higher-rate Polkadot (DOT) balance lookups  (free-tier)
#   get a key: https://support.subscan.io/
SUBSCAN_API_KEY=

# --- Code / repos ------------------------------------------------
# GitHub token — /github-osint + /secrets: higher API limits, repo/code discovery  (free)
#   get a key: https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Search-engine dorking ---------------------------------------
# SerpAPI — /webpivot --serp: Google Ads Transparency (verified paying-advertiser identity) + SERP ads; /dork-sweep · /query · /search-pivot --run: metered fallback when the free DuckDuckGo path fails  (freemium)
#   get a key: https://serpapi.com/manage-api-key
SERPAPI_KEY=
# Bright Data SERP — /dork-sweep: SerpAPI alternative for dork automation + residential SERP  (paid)
#   get a key: https://brightdata.com/products/serp-api
BRIGHTDATA_SERP_KEY=

# --- Optional: persistent intelligence backend ---------------
# Path to the intel_engine engine (persistent KB + cross-case correlation).
# Optional — leave blank to run stateless. When set, unlocks /backend /kb /recall /binary.
# Auto-resolved if blank: .mcp.json > sibling intel_engine/ dir > ~/.claude symlink.
# See connectors/intel-backend.md
INTEL_HOME=

# --- Per-call timeout ceiling ------------------------------------
# Seconds every data-fetching / API / collector / renderer / subprocess call may run before it
# times out and the run moves on. Applied as a FLOOR: a shorter bound written at a call site is
# raised to this value (only raw DNS/TLS/JARM micro-probes keep their fail-fast bounds).
# Resolution: exported env var > this file > intel_engine/WebPivot/references/timeouts.json > 5000.
# Blank -> 5000 (~83 min). Running processes (MCP server, a loop) keep their value until restarted.
CTI_CALL_TIMEOUT=

# --- Egress proxy / rotation  (managed by `/proxy`) --------------
# OPTIONAL. Leave blank to make every request from your real IP. When set, ALL
# outbound HTTP in the skill (keyless crt.sh, Wayback/CDX, urlscan, CLD, WHOIS,
# analytics reverses, `/apikeys test`) routes through the proxy, with automatic
# rotation + failover across a pool. Env here OVERRIDES scripts/proxy/proxies.json.
# Manage without editing this file:  uv run scripts/proxy/proxy.py add <url>
#
# Single proxy — scheme://[user:pass@]host:port  (http/https/socks5/socks5h; a
# bare host:port assumes http://). SOCKS needs PySocks (uv pip install pysocks).
CTI_PROXY=
# Rotation POOL — comma/space/newline separated. Round-robin + failover across all.
CTI_PROXIES=
# Master switch (1/0). Blank -> on whenever a pool exists.
CTI_PROXY_ENABLED=
# Rotation policy: round-robin (default) | random | sticky | off
CTI_PROXY_ROTATION=
# Fall back to a DIRECT connection if EVERY proxy fails (1/0). Default 0 — a pool
# means "never expose the real IP", so direct is off unless you opt in.
CTI_PROXY_ALLOW_DIRECT=
# Per-request timeout (sec) when a caller sets none — a slow/hanging proxy fails
# over instead of blocking forever. Blank -> 20. <=0 disables (block like stdlib).
CTI_PROXY_TIMEOUT=
# Quarantine a proxy for this many seconds after a failure/timeout so it is tried
# last (not first) on later requests. Blank -> 90. 0 disables the health cooldown.
CTI_PROXY_COOLDOWN=
# Hosts always reached without a proxy (csv):
NO_PROXY=localhost,127.0.0.1

# Netlas — DNS / internet-scan / WHOIS / certificate index (https://docs.netlas.io/api-reference/).
# Bearer key from https://app.netlas.io/profile/. Paid plans: unlimited requests; Free: metered. 60 req/min (certs 3/min).
NETLAS_API_KEY=

# Webamon Search — scan corpus + kit fingerprints (https://intel.webamon.com; docs https://docs.webamon.com).
# x-api-key from the intel.webamon.com console. Starter: /search over scans/servers/resources/feeds/infostealers;
# campaigns/clusters need research_lab/soc/mssp. No credits — the vendor's daily 429 is the only limit.
WEBAMON_API_KEY=

# PublicWWW — /webpivot + corpus_search publicwww.source: HTML source-code reverse search -> hosts sharing a snippet  (paid)
#   get a key: https://publicwww.com/profile/api.html
PUBLICWWW_API_KEY=

# Quarry — remote scan platform over MCP. Reuses a scan it already finished, or runs one and waits,
# so the same vendor accounts are not paid twice. QUARRY_ENABLED: on (always) | off (never) | ask
# (default — ask once per case, remembered). The key is an owned fullaccess key; never commit it.
QUARRY_ENABLED=ask
QUARRY_MCP_URL=
QUARRY_API_KEY=
