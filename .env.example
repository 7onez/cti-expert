# ============================================================================
#  cti-expert — API keys  (.env.example)
# ============================================================================
#  cti-expert runs KEYLESS / FREE by default. EVERY key below is OPTIONAL and
#  only *upgrades* an existing capability — leave any blank and that feature
#  falls back to its free/keyless path.
#
#  HOW TO USE
#    1) Copy this file to ".env" in this same folder (the skill root):
#         cp .env.example .env
#    2) Paste in the keys you have; leave the rest blank.
#    -- or, instead of editing the file --
#         uv run scripts/apikeys/apikeys.py set shodan <YOUR_KEY>
#
#  Resolution order:  environment variable  >  this .env  >  keyless
#  Security:  never commit your real ".env" (it is gitignored); chmod 600.
#  Check:     uv run scripts/apikeys/apikeys.py status | test | unlocks
#  Regenerate:  uv run scripts/apikeys/apikeys.py example > .env.example
# ============================================================================

# --- Infrastructure / host search --------------------------------
# Shodan — /webpivot: reverse favicon mmh3 hash -> hosts; /cert-pivot: reverse TLS cert fingerprint -> hosts; host/service intelligence  (freemium)
#   get a key: https://account.shodan.io
SHODAN_API_KEY=
# Censys — /webpivot: reverse favicon MD5 -> hosts; /cert-pivot: cert fingerprint_sha256 -> hosts; certificate + host search  (freemium)
#   get a key: https://accounts.censys.io/settings/personal-access-tokens
CENSYS_API_KEY=
CENSYS_ORG_ID=
CENSYS_API_ID=
# FOFA — /webpivot: reverse favicon icon_hash + tracker body -> hosts; IP reverse  (freemium)
#   get a key: https://fofa.info
FOFA_KEY=
FOFA_EMAIL=
# urlscan.io PRO — /webpivot + /scam-check: authenticated DOM content search, related domains/IPs, submit scans  (freemium)
#   get a key: https://urlscan.io/user/apikey/
URLSCAN_API_KEY=

# --- DNS / certs / WHOIS -----------------------------------------
# SecurityTrails — /webpivot + /dns-history: passive DNS, subdomains, WHOIS + DNS history  (freemium)
#   get a key: https://securitytrails.com/app/account/credentials
SECURITYTRAILS_API_KEY=
SECURITYTRAILS_API_KEY_FALLBACK=
# WhoisXML — /webpivot --whois + /whois: current + historic WHOIS, reverse-WHOIS by email/name  (freemium)
#   get a key: https://whoisxmlapi.com
WHOISXML_API_KEY=
# SSLMate CertSpotter — /cert-history + /webpivot: higher-rate CT lookups (optional; crt.sh is free/keyless)  (free-tier)
#   get a key: https://sslmate.com/certspotter/
CERTSPOTTER_API_KEY=
# ZoneCruncher / zetalytics — /webpivot + /dns-history: liveDNS, reverse-email -> domains registered by an email  (freemium)
#   get a key: https://zonecruncher.com
ZONECRUNCHER_API_KEY=

# --- Analytics-ID pivot ------------------------------------------
# DNSLytics — /webpivot: reverse AdSense (ca-pub-) / legacy GA (UA-) ID -> sibling domains  (freemium)
#   get a key: https://dnslytics.com/api
DNSLYTICS_API_KEY=

# --- Breach / leak / darknet -------------------------------------
# Hudson Rock — /breach-deep + /stealer-log: infostealer-breach feed lookups  (freemium)
#   get a key: https://www.hudsonrock.com
HUDSONROCK_API_KEY=
# ChongLuaDao — /scam-check + /breach-deep: Vietnamese phishing/scam + breach feed; /email-hygiene: disposable/burner email detection  (free-tier)
#   get a key: https://chongluadao.vn
CHONGLUADAO_API_KEY=
# Intelligence X (IntelX) — /breach-deep + darknet search: dark-web, paste, and leak selectors  (freemium)
#   get a key: https://intelx.io/account?tab=developer
INTELX_API_KEY=

# --- Crypto / blockchain -----------------------------------------
# Blockchair — /crypto-balance + /webpivot --wallets: full balance + lifetime received/sent across BTC/ETH/LTC/BCH/DOGE/DASH/ZEC  (freemium)
#   get a key: https://blockchair.com/api/docs
BLOCKCHAIR_API_KEY=
# Subscan — /crypto-balance: higher-rate Polkadot (DOT) balance lookups  (free-tier)
#   get a key: https://support.subscan.io/
SUBSCAN_API_KEY=

# --- Code / repos ------------------------------------------------
# GitHub token — /github-osint + /secrets: higher API limits, repo/code discovery  (free)
#   get a key: https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Search-engine dorking ---------------------------------------
# SerpAPI — /dork-sweep + /query: automated Google dork queries  (freemium)
#   get a key: https://serpapi.com/manage-api-key
SERPAPI_KEY=
# Bright Data SERP — /dork-sweep: SerpAPI alternative for dork automation + residential SERP  (paid)
#   get a key: https://brightdata.com/products/serp-api
BRIGHTDATA_SERP_KEY=
