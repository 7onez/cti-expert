# Claude Code session state
.claude/

# Python cache
__pycache__/
*.pyc
*.pyo

# OS files
.DS_Store
Thumbs.db

# OSINT report outputs (generated at runtime)
osint-reports/
OSINT-REPORT-*
CTI-REPORT-*
# ...but NOT the HTML report template: on case-insensitive filesystems (Windows/macOS)
# the CTI-REPORT-* rule above otherwise swallows scripts/cti-report-template.html.
!scripts/cti-report-template.html
plans/

# Runtime-installed third-party tools (cloned by the installer)
vendor/

# Virtual environments
.venv/

# API keys (managed by /apikeys) — NEVER commit
.env
scripts/**/.env

# Local intel-backend MCP registration (absolute path, machine-specific).
# Written by `scripts/backend/intel.py mcp --write` to enable Tier 1 — never commit.
.mcp.json

# Vendored intel-engine runtime DATA (fresh, local-only — never commit)
/intel_engine/cases/
/intel_engine/knowledge/entities/
/intel_engine/knowledge/evidence/
/intel_engine/knowledge/relationships/edges.jsonl
/intel_engine/knowledge/*.jsonl
