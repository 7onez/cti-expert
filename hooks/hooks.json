{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/leakguard.py"],
            "timeout": 30,
            "statusMessage": "RULE 1 leak check"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/actionguard.py"],
            "timeout": 15,
            "statusMessage": "outbound-action gate"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/sessionguard.py"],
            "timeout": 25,
            "statusMessage": "cti-expert backend check"
          }
        ]
      }
    ]
  }
}
