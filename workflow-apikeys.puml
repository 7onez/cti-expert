@startuml
title cti-expert v2.6 — /webpivot + correlation + premium API-key workflow
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam ArrowColor #34495E
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2C6FBB
  DiamondBackgroundColor #FFF3D6
  DiamondBorderColor #C8901F
